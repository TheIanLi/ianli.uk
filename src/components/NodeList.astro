---
// 按分类排列的节点列表。阶段 0 是首页本身；接上 3D 后作为"无 WebGL 退路"和搜索引擎可读的内容。
import { getGraph } from '../lib/graph';
import { CATS, CAT_ORDER } from '../lib/meta';

const { nodes } = await getGraph();
---

<div class="node-list">
  {
    CAT_ORDER.map((k) => {
      const list = nodes.filter((n) => n.cat === k);
      return (
        list.length > 0 && (
          <section style={`--c:${CATS[k].color}`}>
            <h3>
              <i class="dot" />
              {CATS[k].name}
              <em>{String(list.length).padStart(2, '0')}</em>
            </h3>
            <ul>
              {list.map((n) => (
                <li id={n.slug}>
                  <a href={`/n/${n.slug}/`}>
                    <b>{n.title}</b>
                    <small>{n.code}</small>
                  </a>
                  <span>{n.summary}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })
  }
</div>

<style>
  .node-list {
    display: grid;
    gap: 32px;
  }
  h3 {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    text-transform: uppercase;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  h3 em {
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  li a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    margin-bottom: 3px;
  }
  li a:hover b {
    color: var(--c);
  }
  li b {
    font-size: 15.5px;
    font-weight: 600;
    transition: color 0.2s;
  }
  li small {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.1em;
  }
  li span {
    display: block;
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.7;
  }
</style>
