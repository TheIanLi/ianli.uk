---
// 基础版 404。阶段 3 再做成星图风格。
import Base from '../layouts/Base.astro';
---

<Base title="404 · 这个坐标没有星星" bodyClass="starfield">
  <main class="wrap">
    <div class="code">ERR 404 · SIGNAL LOST</div>
    <h1>这个坐标没有星星</h1>
    <pre class="cmd"><span class="ln">goto <span id="path"></span></span>
<span class="ln note">goto: 没有这个节点</span></pre>
    <a class="back" href="/">← 回到星图</a>
  </main>
</Base>

<script is:inline>
  document.getElementById('path').textContent = location.pathname;
</script>

<style>
  .wrap {
    min-height: 100vh;
    min-height: 100dvh;
    max-width: 560px;
    margin: 0 auto;
    padding-inline: 20px;
    display: grid;
    align-content: center;
    gap: 18px;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--ink-3);
  }
  h1 {
    margin: 0;
    font-size: clamp(26px, 6vw, 38px);
    font-weight: 600;
  }
  .back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
    text-decoration: none;
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 7px 14px;
  }
  .back:hover {
    color: var(--ink);
  }
</style>
