---
// 首页：3D 星图岛 + 2D 节点列表（无 WebGL / 无 JS 时的退路，也给搜索引擎读）
import Base from '../layouts/Base.astro';
import NodeList from '../components/NodeList.astro';
import { getGraph } from '../lib/graph';

const graph = await getGraph();
// 节点数据内嵌到页面里，启动器读出来交给 3D（转义 <，防止内容里出现 </script> 截断）
const graphJson = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<Base title="IAN LI · 星图" bodyClass="starfield home">
  <script is:inline slot="head">
    // 支持 WebGL 就先隐藏列表，避免 3D 加载完之前闪一下 2D 内容
    try {
      var c = document.createElement('canvas');
      if (c.getContext('webgl2') || c.getContext('webgl')) document.documentElement.classList.add('has-3d');
      // 网速慢不再自动切 2D：启动器（src/starmap/boot.ts）显示下载进度，慢时给"先看列表"按钮
    } catch (e) {}
  </script>

  <div id="sm-loader">
    <i class="dot" aria-hidden="true"></i>
    <div class="track" aria-hidden="true"><span id="sm-bar"></span></div>
    <div class="info" role="status"><span id="sm-msg">加载星图</span> <span id="sm-pct">0%</span></div>
    <button id="sm-skip" type="button" hidden>网速较慢？先看列表 →</button>
  </div>
  <div id="sm-root"></div>
  <div id="sm-chip" role="status" hidden>星图加载中</div>
  <button id="sm-enter" type="button" hidden>进入 3D 星图 ✦</button>
  <script type="application/json" id="sm-graph" set:html={graphJson} />
  <script type="application/json" id="sm-manifest">null</script>
  <script>
    import { boot } from '../starmap/boot';
    boot();
  </script>

  <main id="fallback" class="wrap">
    <header>
      <div class="domain">ianli.uk · 星图</div>
      <h1>IAN LI</h1>
      <p>折腾记录与个人笔记</p>
      <a class="gh" href="https://github.com/TheIanLi" target="_blank" rel="noopener">GitHub ↗</a>
    </header>
    <NodeList />
  </main>
</Base>

<style is:global>
  /* 有 3D 时：页面不滚动、隐藏列表；3D 就绪前显示一个脉动的光点 */
  /* 内容全是固定定位，html/body 必须撑满，否则背景渐变画在 0 高度区域里、看起来是灰色 */
  html.has-3d,
  .has-3d body.home {
    height: 100%;
  }
  .has-3d body.home {
    overflow: hidden;
    background: var(--bg) radial-gradient(ellipse 80% 70% at 50% 46%, var(--bg-2), var(--bg) 72%);
  }
  .has-3d #fallback {
    display: none;
  }
  #sm-loader {
    display: none;
  }
  .has-3d:not(.sm-ready) #sm-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    position: fixed;
    inset: 0;
    padding-inline: 24px;
    font-family: var(--font-mono);
  }
  #sm-loader .track {
    width: min(220px, 60vw);
    height: 3px;
    border-radius: 2px;
    background: rgba(196, 200, 255, 0.12);
    overflow: hidden;
  }
  #sm-bar {
    display: block;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, #a68fff, #ffb054);
    transition: transform 0.25s ease-out;
  }
  #sm-loader .info {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
  #sm-pct {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  #sm-skip,
  #sm-enter,
  #sm-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    background: var(--glass);
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 8px 14px;
  }
  #sm-skip,
  #sm-enter {
    cursor: pointer;
  }
  #sm-skip:hover,
  #sm-enter:hover {
    color: var(--ink);
    border-color: rgba(220, 224, 255, 0.28);
  }
  /* 列表模式下：右下角显示后台加载进度 / 加载完成后的"进入"按钮 */
  #sm-chip,
  #sm-enter {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 5;
  }
  #sm-enter {
    color: var(--ink);
    box-shadow: 0 0 24px rgba(255, 176, 84, 0.18);
  }
  #sm-loader .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff4e6;
    box-shadow: 0 0 12px 3px rgba(255, 220, 180, 0.6), 0 0 40px 10px rgba(255, 180, 120, 0.15);
    animation: sm-pulse 1.4s ease-in-out infinite;
  }
  @keyframes sm-pulse {
    50% {
      transform: scale(1.8);
      opacity: 0.6;
    }
  }
</style>

<style>
  .wrap {
    max-width: 720px;
    margin: 0 auto;
    padding-block: calc(56px + env(safe-area-inset-top, 0px)) 64px;
    padding-inline: 20px;
    display: grid;
    gap: 40px;
  }
  header {
    display: grid;
    gap: 8px;
  }
  .domain {
    font-family: var(--font-mono);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-size: 10px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(22px, 4vw, 32px);
    letter-spacing: 0.42em;
    line-height: 1;
  }
  p {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }
  .gh {
    justify-self: start;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 6px 12px;
    text-decoration: none;
  }
  .gh:hover {
    color: var(--ink);
    border-color: rgba(220, 224, 255, 0.28);
  }
</style>
